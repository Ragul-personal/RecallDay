<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for posting notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets us request exact alarms. NOTE: on Android 14+ this is denied by
         default for apps that aren't clocks/calendars, and the user must turn
         it on under "Alarms & reminders". NotificationService degrades to an
         inexact alarm when it's missing rather than failing to schedule. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM is reserved for clock/calendar/alarm apps. Strip it in
         case a dependency's manifest tries to merge it in — shipping it would
         get a "study reminder" app rejected by Play. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />

    <!-- Re-register alarms after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Battery optimization opt-out (we only PROMPT; we never silently disable) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- No storage permissions.
         Backups used to be written to /storage/emulated/0/Documents by raw
         path, which needed broad file access and still failed unpredictably —
         a write could succeed while the matching read returned EACCES. Export
         now goes through the system share sheet and import through the file
         picker, so the OS owns the destination and grants access per file.
         Nothing here needs MANAGE_EXTERNAL_STORAGE. -->

    <!-- Required by google_fonts, which fetches the Inter font from
         fonts.gstatic.com on first launch and caches it. No fonts are bundled
         in pubspec.yaml, so without this the app falls back to the system
         typeface. Flutter injects INTERNET into debug/profile builds
         automatically, so dropping it here only ever broke release builds.
         No app data is sent anywhere — this is font delivery only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="RecallDay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link from notification: recallday://topic/<id> -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="recallday" />
            </intent-filter>
        </activity>

        <!-- flutter_local_notifications receivers.
             The plugin ships its own manifest entries; these are redeclared
             only where we need to widen them (extra OEM quickboot actions on
             the boot receiver). A previously listed
             `ScheduledNotificationBroadcastReceiver` was removed — no such
             class exists in flutter_local_notifications 17.x. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED rescheduler shipped by flutter_local_notifications -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- WorkManager's androidx.startup initializer must stay ENABLED.
             It was previously stripped with tools:node="remove", which is only
             correct when the Application class supplies its own
             Configuration.Provider. We don't, so WorkManager threw
             "not initialized properly", main.dart swallowed the exception, and
             the periodic re-arm sweep silently never ran. -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
