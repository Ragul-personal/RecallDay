<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon.

  Android masks status-bar icons down to their ALPHA channel and tints the
  result, so the artwork must be a transparent silhouette. The launcher icon
  (ic_launcher.xml) fills its whole 108x108 canvas with an opaque rect, which
  is why using it here rendered as a solid white square.

  Motif: a circular "replay" arrow — the spaced-repetition loop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Arc: open circle broken at the top-right for the arrowhead. -->
    <path
        android:fillColor="#FFFFFFFF"
