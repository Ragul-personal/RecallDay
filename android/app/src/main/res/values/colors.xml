<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive-icon background. Matches the logo artwork's own background so
         the flat background layer and the mark's foreground PNG meet with no
         visible seam once the launcher masks them to a circle/squircle. -->
    <color name="ic_launcher_background">#FDFFFE</color>

    <!-- Native window background shown for the instant before Flutter's first
         frame. Matches AppTheme.dark()'s scaffold colour so launch doesn't
         flash a different shade. -->
    <color name="launch_background">#0E1116</color>
</resources>
