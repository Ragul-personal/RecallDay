<?xml version="1.0" encoding="utf-8"?>
<!--
  Protects resources that only Dart code names, from `shrinkResources true`.

  `ic_stat_recall` is passed to AndroidInitializationSettings as a plain STRING
  from Dart. Nothing in the manifest, XML, or Java R class references it, so the
  resource shrinker treats it as unused and strips it from the release APK —
  after which flutter_local_notifications cannot resolve the icon and throws
  during init. In a release build that surfaced as a black screen on launch,
  because the throw happened before runApp().

  @drawable/ic_launcher now MUST be listed. The launcher icon moved to
  @mipmap/ic_launcher (the logo artwork), so the old vector drawable is
  referenced from nowhere but NotificationService's fallback path — another
  Dart string the shrinker can't see.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_recall,@drawable/ic_launcher" />
