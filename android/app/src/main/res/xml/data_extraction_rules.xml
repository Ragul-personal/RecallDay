<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) replacement for backup_rules.xml.

  `cloud-backup`   — Google account backup, restored on reinstall.
  `device-transfer` — direct phone-to-phone migration.

  Exclude-only, for the same reason as backup_rules.xml: adding any <include>
  turns these into allow-lists, and Hive's boxes live under
  /data/data/<pkg>/app_flutter (domain="root" path="app_flutter"), not in the
  "file" domain. Listing nothing keeps the default "back up everything".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="app_flutter/subjects.lock" />
        <exclude domain="root" path="app_flutter/topics.lock" />
        <exclude domain="root" path="app_flutter/reviews.lock" />
        <exclude domain="root" path="app_flutter/prefs.lock" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="app_flutter/subjects.lock" />
        <exclude domain="root" path="app_flutter/topics.lock" />
        <exclude domain="root" path="app_flutter/reviews.lock" />
        <exclude domain="root" path="app_flutter/prefs.lock" />
    </device-transfer>
</data-extraction-rules>
